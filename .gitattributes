# Windows shell scripts require CRLF for cmd.exe label parsing
# (LF-only .bat files break `goto label` at runtime).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.sh text eol=lf
.github/workflows/*.yml text eol=lf

# Embedded scripts and byte-verified upstream themes must stay stable across checkouts.
assets/inject/*.js text eol=lf
assets/inject/upstream/**/*.js text eol=lf
assets/inject/upstream/**/*.css text eol=lf

# Keep repository-owner branding when selectively merging upstream releases.
README.md merge=binary
README_EN.md merge=binary
assets/images/sponsor-alipay.jpg merge=binary
assets/images/sponsor-wechat.jpg merge=binary
